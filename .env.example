# Beispiel-Konfiguration (bitte als .env kopieren und anpassen):
#   cp .env.example .env
#   openssl rand -hex 32   -> Wert für SECRET_KEY

SECRET_KEY=
HOST=0.0.0.0
PORT=5000

# Nur "true" setzen, wenn die Anwendung hinter HTTPS läuft.
# COOKIE_SECURE=false

# Optional: Wechsel auf MariaDB (später möglich):
# DATABASE_URL=mysql+pymysql://benutzer:passwort@host:3306/datenbank
