# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Umgebung & Secrets
.env

# Datenbank
database/*.db
database/*.db-*

# Hochgeladene Medien (nur .gitkeep behalten)
uploads/images/*
uploads/videos/*
uploads/audio/*
!uploads/images/.gitkeep
!uploads/videos/.gitkeep
!uploads/audio/.gitkeep

# Ankündigungsbilder: Projektdateien + Hintergründe (nur .gitkeep behalten)
uploads/announcements/*
!uploads/announcements/.gitkeep

# Auto-Slides: gerenderte Hochformat-PNGs (nur .gitkeep behalten)
uploads/auto_slides/*
!uploads/auto_slides/.gitkeep

# Logs & Betriebssystem
*.log
.DS_Store
Thumbs.db
